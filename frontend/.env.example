# ===== FRONTEND (a "lente") =====
# URL do backend (cérebro). O front só fala HTTP com ela: nunca importa código do backend e nunca chama o LLM.
API_URL=http://localhost:8000
# Mesma chave definida em API_KEY no .env do backend (enviada no header X-API-Key).
# Fica no servidor do Streamlit/Gradio: nunca é exposta ao navegador.
API_KEY=troque-esta-chave
# Tempo máximo (s) de espera por uma resposta do /chat. O LLM local pode levar de 5 a 15 s (1ª chamada carrega o modelo).
API_TIMEOUT_S=75
# Tempo máximo (s) para o /health e para as demais rotas rápidas.
API_FAST_TIMEOUT_S=5
