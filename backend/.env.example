# ===== API =====
# Chave exigida no header X-API-Key. Deixe vazio para desativar a autenticação (apenas em desenvolvimento).
API_KEY=troque-esta-chave
# Origens permitidas (CORS), separadas por vírgula: Streamlit (8501) e Gradio (7860)
CORS_ORIGINS=http://localhost:8501,http://localhost:7860

# ===== MODELO DE LINGUAGEM (único ponto de troca: app/llm/client.py) =====
# ollama | openai_compat | mock
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Ollama local
OLLAMA_URL=http://localhost:11434
# Provedor com API compatível com OpenAI (Groq, OpenRouter, Gemini-OpenAI...). Só se LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=220
LLM_NUM_CTX=4096
# true: o LLM verbaliza FAQ e perguntas do fluxo (sempre validado pelos guardrails). false: só templates (zero LLM).
LLM_VERBALIZE=true
# error: LLM fora do ar => HTTP 503 nos turnos que dependem dele (turnos críticos continuam funcionando)
# degrade: LLM fora do ar => responde com o texto-base curado
LLM_FAIL_MODE=error

# ===== MEMÓRIA =====
# Janela deslizante: quantos turnos (pares usuário/bot) vão para o LLM a cada chamada
WINDOW_TURNS=8
SESSION_TTL_MINUTES=240
MAX_SESSIONS=1000

# ===== OUTROS =====
# Fixa a "data de hoje" (YYYY-MM-DD) para testes reproduzíveis. Vazio = data real.
FIXED_TODAY=
# Pasta onde ficam sessões, log por turno (turns.jsonl) e agendamentos. Vazio = backend/data/runtime
RUNTIME_DIR=
